{
  "document": {
    "openapi": "3.1.1",
    "info": {
      "title": "Example",
      "version": "1.0.0"
    },
    "paths": {
      "/pets": {
        "get": {
          "parameters": [
            {
              "$ref": "https://example.com/target.json"
            }
          ],
          "responses": {
            "200": {
              "description": "ok"
            }
          }
        }
      }
    }
  },
  "defaultBase": "https://example.com/openapi.json",
  "resolver": {
    "https://example.com/target.json": {
      "name": "limit",
      "in": "body",
      "schema": {}
    }
  },
  "error": {
    "message": "The Parameter Object location is not one this specification defines",
    "location": "/in",
    "base": "https://example.com/target.json"
  }
}

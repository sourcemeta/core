{
  "document": {
    "openapi": "3.1.1",
    "info": {
      "title": "Example",
      "version": "1.0.0"
    },
    "paths": {
      "/foo": {
        "$ref": "https://example.com/other.json#/components/pathItems/Foo"
      }
    }
  },
  "defaultBase": "https://example.com/openapi.json",
  "resolver": {
    "https://example.com/other.json": {
      "openapi": "3.1.1",
      "info": {
        "title": "Other",
        "version": "1.0.0"
      },
      "components": {
        "securitySchemes": {
          "MySecurity": {
            "type": "apiKey",
            "name": "X-Key",
            "in": "header"
          }
        },
        "pathItems": {
          "Foo": {
            "get": {
              "responses": {
                "200": {
                  "description": "ok"
                }
              },
              "security": [
                {
                  "MySecurity": []
                }
              ]
            }
          }
        }
      }
    }
  },
  "error": {
    "message": "The Security Requirement Object must name a declared security scheme",
    "location": "/components/pathItems/Foo/get/security/0/MySecurity",
    "base": "https://example.com/other.json"
  }
}

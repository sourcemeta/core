{
  "document": {
    "openapi": "3.1.1",
    "info": {
      "title": "Example",
      "version": "1.0.0"
    },
    "components": {
      "callbacks": {
        "C": {
          "$ref": "https://example.com/target.json"
        }
      }
    }
  },
  "defaultBase": "https://example.com/openapi.json",
  "resolver": {
    "https://example.com/target.json": {
      "{$request.body#/url}": {
        "connect": {}
      }
    }
  },
  "error": {
    "message": "The Path Item Object does not define this field",
    "location": "/{$request.body#~1url}/connect",
    "base": "https://example.com/target.json"
  }
}

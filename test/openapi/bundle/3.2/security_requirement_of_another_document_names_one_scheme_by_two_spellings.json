{
  "document": {
    "openapi": "3.2.0",
    "info": {
      "title": "Example",
      "version": "1.0.0"
    },
    "paths": {
      "/foo": {
        "$ref": "other.json#/components/pathItems/Foo"
      }
    }
  },
  "defaultBase": "https://example.com/openapi.json",
  "openapiResolver": {
    "https://example.com/other.json": {
      "openapi": "3.2.0",
      "info": {
        "title": "Example",
        "version": "1.0.0"
      },
      "components": {
        "securitySchemes": {
          "Remote": {
            "type": "http",
            "scheme": "bearer"
          }
        },
        "pathItems": {
          "Foo": {
            "get": {
              "security": [
                {
                  "#/components/securitySchemes/Remote": [
                    "read"
                  ],
                  "other.json#/components/securitySchemes/Remote": [
                    "write"
                  ]
                }
              ],
              "responses": {
                "200": {
                  "description": "OK"
                }
              }
            }
          }
        }
      }
    }
  },
  "schemaResolver": {},
  "error": {
    "type": "OpenAPIError",
    "message": "The Security Requirement Object must not name one security scheme twice",
    "location": "/components/pathItems/Foo/get/security/0/other.json#~1components~1securitySchemes~1Remote",
    "base": "https://example.com/other.json"
  }
}

{
  "document": {
    "openapi": "3.1.1",
    "info": {
      "title": "Example",
      "version": "1.0.0"
    },
    "paths": {
      "/pets": {
        "get": {
          "responses": {
            "200": {
              "description": "OK",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "https://example.com/schemas/pet"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "defaultBase": "https://example.com/openapi.json",
  "openapiResolver": {},
  "schemaResolver": {
    "https://example.com/schemas/pet": {
      "$id": "https://example.com/schemas/pet",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      }
    }
  },
  "maxLocations": 40,
  "error": {
    "type": "OpenAPIBundleLimitError",
    "message": "The OpenAPI Description exceeds the maximum number of locations that bundling may analyse",
    "limit": 40
  }
}
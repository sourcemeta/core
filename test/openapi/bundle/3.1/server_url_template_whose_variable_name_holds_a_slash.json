{
  "document": {
    "openapi": "3.1.1",
    "info": {
      "title": "Example",
      "version": "1.0.0"
    },
    "paths": {
      "/pets": {
        "$ref": "https://example.com/shared.json#/components/pathItems/P"
      }
    }
  },
  "defaultBase": "https://example.com/openapi.json",
  "openapiResolver": {
    "https://example.com/shared.json": {
      "openapi": "3.1.1",
      "info": {
        "title": "shared",
        "version": "1.0.0"
      },
      "components": {
        "pathItems": {
          "P": {
            "servers": [
              {
                "url": "{group/name}{scheme}://api.example.com/v1",
                "variables": {
                  "group/name": {
                    "default": "",
                    "enum": [ "" ]
                  },
                  "scheme": {
                    "default": "https"
                  }
                }
              }
            ],
            "get": {
              "responses": {
                "200": {
                  "description": "ok"
                }
              }
            }
          }
        }
      }
    }
  },
  "schemaResolver": {},
  "error": {
    "type": "OpenAPIError",
    "message": "A Server Object URL template that leaves what it is relative to for its variables to decide cannot be read from another document",
    "location": "/components/pathItems/P/servers/0/url",
    "base": "https://example.com/shared.json"
  }
}

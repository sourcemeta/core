{
  "document": {
    "openapi": "3.1.1",
    "info": {
      "title": "Example",
      "version": "1.0.0"
    },
    "paths": {
      "/pets": {
        "get": {
          "responses": {
            "404": {
              "$ref": "shared.json#/components/responses/NotFound"
            }
          }
        }
      }
    }
  },
  "defaultBase": "https://example.com/openapi.json",
  "openapiResolver": {
    "https://example.com/shared.json": {
      "openapi": "3.0.3",
      "info": {
        "title": "Example",
        "version": "1.0.0"
      },
      "components": {
        "responses": {
          "NotFound": {
            "description": "Not found"
          }
        }
      }
    }
  },
  "schemaResolver": {},
  "error": {
    "type": "OpenAPIError",
    "message": "Unsupported OpenAPI Specification version",
    "location": "/openapi",
    "base": "https://example.com/shared.json"
  }
}

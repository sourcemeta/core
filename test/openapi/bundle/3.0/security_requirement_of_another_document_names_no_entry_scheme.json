{
  "document": {
    "openapi": "3.0.4",
    "info": {
      "title": "Example",
      "version": "1.0.0"
    },
    "paths": {
      "/foo": {
        "$ref": "other.json#/paths/~1foo"
      }
    }
  },
  "defaultBase": "https://example.com/openapi.json",
  "openapiResolver": {
    "https://example.com/other.json": {
      "openapi": "3.0.4",
      "info": {
        "title": "Example",
        "version": "1.0.0"
      },
      "components": {
        "securitySchemes": {
          "RemoteOnly": {
            "type": "http",
            "scheme": "bearer"
          }
        }
      },
      "paths": {
        "/foo": {
          "get": {
            "security": [
              {
                "RemoteOnly": []
              }
            ],
            "responses": {
              "200": {
                "description": "OK"
              }
            }
          }
        }
      }
    }
  },
  "schemaResolver": {},
  "error": {
    "type": "OpenAPIError",
    "message": "The Security Requirement Object must name a declared security scheme",
    "location": "/paths/~1foo/get/security/0/RemoteOnly",
    "base": "https://example.com/other.json"
  }
}

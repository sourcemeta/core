{
  "document": {
    "openapi": "3.0.4",
    "info": { "title": "Example", "version": "1.0.0" },
    "paths": {
      "/pets": {
        "get": {
          "responses": {
            "200": {
              "description": "Some pets",
              "links": { "Owner": { "operationId": "getOwner" } }
            },
            "404": { "$ref": "shared.json#/components/responses/NotFound" }
          }
        }
      }
    }
  },
  "defaultBase": "https://example.com/openapi.json",
  "openapiResolver": {
    "https://example.com/shared.json": {
      "openapi": "3.0.4",
      "info": { "title": "Shared", "version": "1.0.0" },
      "paths": {
        "/owners": {
          "get": {
            "operationId": "getOwner",
            "responses": { "200": { "description": "Owners" } }
          }
        }
      },
      "components": {
        "responses": { "NotFound": { "description": "Not found" } }
      }
    }
  },
  "schemaResolver": {},
  "error": {
    "type": "OpenAPIError",
    "message": "The Link Object operation identifier must name an operation the OpenAPI Description declares",
    "location": "/paths/~1pets/get/responses/200/links/Owner/operationId"
  }
}

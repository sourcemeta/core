RUN --out 'version 1.2 here' --out 'keep me' --out ': PASS 1/1' STDIN /dev/null IN . INTO result.txt EXPECTING 0
REPLACE 'keep me' WITH kept IN result.txt
REPLACE MATCHING '[0-9]+\.[0-9]+' WITH '<FLOAT>' IN result.txt
DROP LINES MATCHING ': PASS 1/1$' IN result.txt
WRITE expected.txt UNTIL END
1> version <FLOAT> here
1> kept
END
COMPARE result.txt AGAINST expected.txt

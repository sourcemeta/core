{
  "document": {
    "openapi": "3.0.4",
    "info": {
      "title": "Example",
      "version": "1.0.0"
    },
    "paths": {
      "/pets": {
        "get": {
          "responses": {
            "404": {
              "$ref": "shared.json#/components/responses/NotFound"
            }
          }
        }
      }
    }
  },
  "defaultBase": "https://example.com/openapi.json",
  "openapiResolver": {
    "https://example.com/shared.json": {
      "openapi": "3.0.4",
      "info": {
        "title": "Shared",
        "version": "1.0.0"
      },
      "components": {
        "responses": {
          "NotFound": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://example.com/schemas/error"
                }
              }
            }
          }
        }
      },
      "paths": {}
    }
  },
  "schemaResolver": {
    "https://example.com/schemas/error": {
      "$id": "https://example.com/schemas/error",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object"
    }
  },
  "error": {
    "type": "OpenAPIError",
    "message": "A Schema Object of this revision must be written against the OpenAPI 3.0 dialect",
    "location": "/components/schemas/error"
  }
}

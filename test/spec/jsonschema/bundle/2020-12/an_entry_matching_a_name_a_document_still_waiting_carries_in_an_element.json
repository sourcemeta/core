{
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.com/root",
    "allOf": [
      {
        "$ref": "https://example.com/outer"
      },
      {
        "$ref": "https://example.com/third"
      }
    ],
    "properties": {
      "x": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://example.com/inner",
        "type": "string"
      }
    }
  },
  "resolver": {
    "https://example.com/outer": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://example.com/outer",
      "$defs": {
        "https://example.com/inner": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "https://example.com/inner",
          "type": "string"
        }
      }
    },
    "https://example.com/third": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://example.com/third",
      "prefixItems": [
        {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "https://example.com/inner",
          "type": "string"
        }
      ]
    }
  },
  "result": {},
  "inserted": {},
  "errors": {
    "nonOfficialMetaschemas": {
      "type": "SchemaError",
      "message": "Conflicting embedded resources with the same identifier"
    },
    "references": {
      "type": "SchemaError",
      "message": "Conflicting embedded resources with the same identifier"
    }
  }
}

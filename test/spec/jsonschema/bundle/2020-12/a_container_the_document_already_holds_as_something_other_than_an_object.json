{
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.com/root",
    "$defs": 5,
    "allOf": [
      { "$ref": "https://example.com/inner" },
      { "$ref": "https://example.com/outer" }
    ]
  },
  "resolver": {
    "https://example.com/inner": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://example.com/inner",
      "type": "string"
    },
    "https://example.com/outer": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://example.com/outer",
      "$defs": {
        "https://example.com/inner": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "https://example.com/inner",
          "type": "string"
        }
      }
    }
  },
  "result": {},
  "errors": {
    "nonOfficialMetaschemas": {
      "type": "SchemaContainerError",
      "message": "Could not bundle to a container that is not an object",
      "location": "/$defs"
    },
    "references": {
      "type": "SchemaContainerError",
      "message": "Could not bundle to a container that is not an object",
      "location": "/$defs"
    }
  },
  "inserted": {}
}

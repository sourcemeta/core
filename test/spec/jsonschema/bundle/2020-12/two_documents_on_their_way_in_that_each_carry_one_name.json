{
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.com/root",
    "allOf": [
      {
        "$ref": "https://example.com/a"
      },
      {
        "$ref": "https://example.com/b"
      }
    ]
  },
  "resolver": {
    "https://example.com/a": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://example.com/a",
      "prefixItems": [
        {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "https://example.com/inner",
          "type": "string"
        }
      ]
    },
    "https://example.com/b": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://example.com/b",
      "$defs": {
        "friendly": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "https://example.com/inner",
          "type": "string"
        }
      }
    }
  },
  "result": {},
  "inserted": {},
  "errors": {
    "nonOfficialMetaschemas": {
      "type": "SchemaError",
      "message": "Conflicting embedded resources with the same identifier"
    },
    "references": {
      "type": "SchemaError",
      "message": "Conflicting embedded resources with the same identifier"
    }
  }
}

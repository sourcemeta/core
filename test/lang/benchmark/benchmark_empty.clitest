RUN STDIN /dev/null IN . INTO result.txt EXPECTING 1
WRITE expected.txt UNTIL EXPECTED
2> error: No benchmarks were registered
EXPECTED
COMPARE result.txt AGAINST expected.txt

RUN --repeat 2 STDIN /dev/null IN . INTO result.txt EXPECTING 1
WRITE expected.txt UNTIL EXPECTED
2> error: No benchmarks were registered
EXPECTED
COMPARE result.txt AGAINST expected.txt

RUN --repeat 2 --filter "" STDIN /dev/null IN . INTO result.txt EXPECTING 1
WRITE expected.txt UNTIL EXPECTED
2> error: No benchmarks were registered
EXPECTED
COMPARE result.txt AGAINST expected.txt

RUN --repeat 2 --filter nothingmatchesthis STDIN /dev/null IN . INTO result.txt EXPECTING 0
REPLACE MATCHING "Running on [0-9]+ processors" WITH "Running on N processors" IN result.txt
WRITE expected.txt UNTIL EXPECTED
1> Running on N processors
EXPECTED
COMPARE result.txt AGAINST expected.txt

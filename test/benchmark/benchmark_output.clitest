RUN -f addition -o out.json STDIN /dev/null IN . INTO result.txt EXPECTING 0
REPLACE MATCHING "Running on [0-9]+ processors" WITH "Running on N processors" IN result.txt
REPLACE MATCHING "time: [0-9]+\.[0-9]+ [a-z]+(?:, cpu: [0-9]+\.[0-9]+ [a-z]+)?, first: [0-9]+\.[0-9]+ [a-z]+, iterations: [0-9]+" WITH "<measurement>" IN result.txt
WRITE expected.txt UNTIL EXPECTED
1> Running on N processors
1> addition
1>   <measurement>
EXPECTED
COMPARE result.txt AGAINST expected.txt
REPLACE MATCHING '"num_cpus": [0-9]+' WITH '"num_cpus": 0' IN out.json
REPLACE MATCHING '"iterations": [0-9]+' WITH '"iterations": 0' IN out.json
REPLACE MATCHING '"real_time": [0-9.e+-]+' WITH '"real_time": 0' IN out.json
REPLACE MATCHING '"cpu_time": [0-9.e+-]+' WITH '"cpu_time": 0' IN out.json
WRITE expected.json UNTIL EXPECTED
{
  "context": {
    "num_cpus": 0
  },
  "benchmarks": [
    {
      "name": "addition",
      "family_index": 0,
      "per_family_instance_index": 0,
      "run_name": "addition",
      "run_type": "aggregate",
      "repetitions": 3,
      "aggregate_name": "min",
      "threads": 1,
      "iterations": 0,
      "real_time": 0,
      "cpu_time": 0,
      "time_unit": "ns"
    }
  ]
}
EXPECTED
COMPARE out.json AGAINST expected.json

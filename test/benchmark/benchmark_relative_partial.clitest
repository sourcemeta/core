WRITE base.json UNTIL BASELINE
{
  "benchmarks": [
    { "name": "addition", "real_time": 4.0, "cpu_time": 4.0, "time_unit": "ns" },
    { "name": "gone_from_the_suite", "real_time": 9.0, "cpu_time": 9.0, "time_unit": "ns" }
  ]
}
BASELINE
RUN --relative-to base.json --output out.json STDIN /dev/null IN . INTO result.txt EXPECTING 0
DROP LINES MATCHING "^1>   " IN result.txt
REPLACE MATCHING "Running on [0-9]+ processors" WITH "Running on N processors" IN result.txt
WRITE expected.txt UNTIL EXPECTED
1> Running on N processors
1> Reporting relative to base.json
1> addition
1> multiplication
1> subtraction
EXPECTED
COMPARE result.txt AGAINST expected.txt
REPLACE MATCHING '"real_time": [0-9.e+-]+' WITH '"real_time": 0' IN out.json
REPLACE MATCHING '"cpu_time": [0-9.e+-]+' WITH '"cpu_time": 0' IN out.json
REPLACE MATCHING '"iterations": [0-9]+' WITH '"iterations": 0' IN out.json
REPLACE MATCHING '"num_cpus": [0-9]+' WITH '"num_cpus": 0' IN out.json
DROP LINES CONTAINING "family_index" IN out.json
DROP LINES CONTAINING "per_family_instance_index" IN out.json
DROP LINES CONTAINING "repetition" IN out.json
DROP LINES CONTAINING "run_name" IN out.json
DROP LINES CONTAINING "run_type" IN out.json
DROP LINES CONTAINING "threads" IN out.json
WRITE expected.json UNTIL EXPECTED
{
  "context": {
    "num_cpus": 0
  },
  "benchmarks": [
    {
      "name": "addition",
      "iterations": 0,
      "real_time": 0,
      "cpu_time": 0,
      "time_unit": "x"
    }
  ],
  "unmatched": [
    {
      "name": "multiplication",
      "iterations": 0,
      "real_time": 0,
      "cpu_time": 0,
      "time_unit": "ns"
    },
    {
      "name": "subtraction",
      "iterations": 0,
      "real_time": 0,
      "cpu_time": 0,
      "time_unit": "ns"
    }
  ]
}
EXPECTED
COMPARE out.json AGAINST expected.json

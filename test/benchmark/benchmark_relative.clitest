WRITE base.json UNTIL BASELINE
{
  "benchmarks": [
    { "name": "addition", "real_time": 4.0, "cpu_time": 4.0, "time_unit": "ns" }
  ]
}
BASELINE
RUN -f addition -r base.json STDIN /dev/null IN . INTO result.txt EXPECTING 0
REPLACE MATCHING "Running on [0-9]+ processors" WITH "Running on N processors" IN result.txt
REPLACE MATCHING "time: [0-9]+\.[0-9]+ [a-z]+ \([0-9]+\.[0-9]+x\)" WITH "time: <measurement>" IN result.txt
REPLACE MATCHING "cpu: [0-9]+\.[0-9]+ [a-z]+ \([0-9]+\.[0-9]+x\)" WITH "cpu: <measurement>" IN result.txt
REPLACE MATCHING "first: [0-9]+\.[0-9]+ [a-z]+" WITH "first: <duration>" IN result.txt
REPLACE MATCHING "iterations: [0-9]+" WITH "iterations: <count>" IN result.txt
WRITE expected.txt UNTIL EXPECTED
1> Running on N processors
1> Reporting relative to base.json
1> addition
1>   time: <measurement>, cpu: <measurement>, first: <duration>, iterations: <count>
EXPECTED
COMPARE result.txt AGAINST expected.txt

// A report that is itself proportional must not pass as a baseline, or the two
// comparisons compound into a meaningless number
WRITE base.json UNTIL BASELINE
{
  "benchmarks": [
    { "name": "addition", "real_time": 2.0, "cpu_time": 2.0, "time_unit": "x" }
  ]
}
BASELINE
RUN --relative-to base.json STDIN /dev/null IN . INTO result.txt EXPECTING 1
WRITE expected.txt UNTIL EXPECTED
2> error: cannot use base.json as a baseline, it holds proportional results rather than durations
EXPECTED
COMPARE result.txt AGAINST expected.txt
